{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freehtlguide.com/schemas/question-review-event.schema.json",
  "title": "FHL Question Review Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "question_id", "question_version", "content_digest",
    "review_type", "decision", "reviewer", "reviewed_at", "confidence",
    "checklist", "verified_references", "comments", "issue_codes"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^rev-[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 12, "maxLength": 120},
    "question_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 8, "maxLength": 96},
    "question_version": {"type": "integer", "minimum": 1},
    "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "review_type": {"enum": ["scientific", "editorial"]},
    "decision": {"enum": ["approved", "changes_requested"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "role_note"],
      "properties": {
        "id": {"type": "string", "minLength": 2, "maxLength": 120},
        "display_name": {"type": "string", "minLength": 2, "maxLength": 120},
        "role_note": {"type": "string", "minLength": 5, "maxLength": 500}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "checklist": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "minProperties": 1
    },
    "verified_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "comments": {"type": "string", "maxLength": 4000},
    "issue_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
    },
    "supersedes_event_id": {
      "type": ["string", "null"],
      "pattern": "^rev-[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
