# Browser-safe deployment values only.
# Copy to a local ignored environment file and replace placeholders for the intended environment.
# Never put service-role keys, secret keys, database passwords, deployment tokens,
# private signing secrets, or payment secrets in this file.

FHL_ENVIRONMENT=local
FHL_PUBLIC_SITE_URL=http://127.0.0.1:4173
FHL_SUPABASE_URL=https://example-project.supabase.co
FHL_SUPABASE_PUBLISHABLE_KEY=replace-with-browser-safe-publishable-key

# Optional consent-gated analytics configuration.
# Leave blank when analytics is disabled.
FHL_ANALYTICS_PROVIDER=
FHL_ANALYTICS_SITE_ID=

# Server-only variable names are documented below for operator awareness only.
# Do not assign real values in committed files.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
# CLOUDFLARE_API_TOKEN=
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_WEBHOOK_SIGNING_SECRET=
